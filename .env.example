# QRSIP — .env.example
#
# Copy this file to .env and edit locally. NEVER commit .env or any file
# containing real secrets. See SECURITY.md and spec §37.
#
# Configuration is otherwise driven by configs/*.yaml. Environment variables
# are an optional override mechanism only (spec §28).

# ------------------------------------------------------------------
# Optional runtime overrides
# ------------------------------------------------------------------
# QRSIP_LOG_LEVEL=INFO
# QRSIP_DATA_PATH=./data
# QRSIP_REPORT_DIR=./reports
